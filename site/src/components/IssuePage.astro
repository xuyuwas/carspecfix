---
import Base from '../layouts/Base.astro';
import Tools from './Tools.astro';
import Feedback from './Feedback.astro';
import ActionPlan from './ActionPlan.astro';
import ReviewDates from './ReviewDates.astro';
import { liveVehicles, liveIssues, issueGate, issueUrl, vehicleUrl, sourcedCauses, sourcedUrgency, guidance, allBrandDrive, SITE } from '../lib/gate.mjs';
import { actionPlan, hasActionPlan } from '../lib/verdicts.mjs';
import { tierOf, TIER_SHORT } from '../lib/tiers.mjs';
import { fitTitle } from '../lib/title.mjs';
import { makeRefs } from '../lib/refs.mjs';
import { AUTHOR } from '../lib/site.mjs';
const { i } = Astro.props;
const code = i.type === 'code';
const path = issueUrl(i);
const { list: refs, ref } = makeRefs();
const r = it => ref(it.url, `${it.document}${it.page ? ', ' + it.page : ''}${it.fetched ? ', retrieved ' + it.fetched : ''}`, it.url);
const def = i.definition && i.definition.sourceGrade === 'A' ? i.definition : null;
const causes = sourcedCauses(i), top = allBrandDrive(i);
// Brand-scoped items that already carry a verdict are rendered as a row in the action
// plan above; repeating them in the brand block made the same Toyota instruction
// appear twice on one screen.
const brandLines = guidance(i).filter(g => !g.allBrands && !g.verdict);
const plan = actionPlan(i);
const urgency = sourcedUrgency(i);
const stats = code && i.nhtsaStats ? i.nhtsaStats : null;   // NHTSA flat-file counts, code pages only
const nf = n => n.toLocaleString('en-US');
const scopeTag = g => (g.appliesTo || '').replace(/^vehicle-specific:\s*/i, '').replace(/^(\w+).*?(\d{4}).*$/, (m, a, y) => /Toyota/.test(m) ? 'Toyota only' : `${y} ${a} only`).trim();
const label = code ? i.code : i.title;
// Per-page title override lives in data (`seo.title`), never in the formula: changing
// fitTitle would move every page's title at once. An override is only used when it
// passes the same 60-char ceiling R-M2 enforces, so a long value degrades to the formula
// instead of silently failing the build.
const override = i.seo && typeof i.seo.title === 'string' ? i.seo.title.trim() : '';
const title = override && override.length <= 60 ? override
  : code ? fitTitle(`${i.code} Code`, ['Meaning', 'Causes', 'Can You Keep Driving?'], { brand: true }).replace('Causes & Can', 'Causes & Can')
         : fitTitle(i.title, ['Causes', 'Is It Safe to Drive?']);
const h1 = code ? `${i.code}: ${def ? def.value : 'meaning'}, causes & can you keep driving?` : `${i.title}: causes & is it safe to drive?`;
// The description used to be assembled from `guidancePrimary`, a prose string that
// named both the steady-light and the flashing-light instruction. On an EVAP code
// that put "if it flashes, reduce speed" in the search result even though the page
// deliberately does not carry the flashing wording (it is a misfire instruction).
// Build it from the action plan instead, so the description can only say what the
// page actually shows.
// Code pages are often searched with the letter O typed for the zero (PO456 for P0456).
// The variant goes into the description so the snippet a reader sees on that spelling
// already says it is the same code — and only when the data declares it, never guessed
// from the digits.
const altSuffix = code && Array.isArray(i.altSpellings) && i.altSpellings.length ? ` (also typed ${i.altSpellings.join(', ')})` : '';
const meaning = code && def ? `${i.code}${altSuffix} means ${def.value.replace(/\.+$/, '')}. ` : '';
// A brand-scoped row must not become the page's summary line: the brake pages would
// otherwise describe themselves with a Toyota-only stop instruction. Prefer the row
// that applies to every vehicle.
const descRow = plan.find(p => !p.scope) || plan[0];
const cap = s => s.replace(/^./, m => m.toUpperCase());
const lead = descRow ? `${cap(descRow.action)}. ` : '';
const build = (g, withCauses) => `${meaning}${g}${withCauses && causes.length ? ' Causes from manufacturer documents.' : ''}`.replace(/\.\./g, '.').replace(/\s+/g, ' ').trim();
const cands = [build(lead, true), build(lead, false), build('', true), build('', false)];
let desc = cands.find(d => d.length <= 160) ?? cands[cands.length - 1];   // still >160 -> kept; build warns (R-M1)
if (!code) {
  const act0 = descRow ? `${cap(descRow.action)}.` : '';
  const opts = [`${i.title}: ${act0} Causes from manufacturer documents.`, `${i.title}: ${act0}`.trim(), `${i.title}: what causes it and whether it is safe to drive.`];
  desc = opts.find(d => d.length <= 160) ?? opts[opts.length - 1];
}
const related = liveIssues.filter(x => i.related?.issues?.includes(x.slug));
const vehicles = liveVehicles.filter(v => i.related?.vehicles?.includes(v.slug));   // R-L2 v2: only data-declared vehicles
const hubUrl = code ? '/codes/' : '/symptoms/';
const crumbs = [{ name: 'Home', url: '/' }, { name: code ? 'Trouble codes' : 'Symptoms', url: hubUrl }, { name: label, url: path }];
const jsonld = [{ '@type': 'Article', headline: h1, datePublished: i.publishDate ?? i.dataUpdated, dateModified: i.dataUpdated, author: { '@type': 'Person', name: AUTHOR.name, url: `${SITE}/authors/${AUTHOR.slug}/` }, mainEntityOfPage: SITE + path }];
// 'Seen on' only with concrete models; internal notes stripped; vague scopes ('models listed') hidden
const seenOn = c => { const t = (c.appliesTo || '').replace(/\s*\([^()]*(verbatim|APPLICABILITY|SIB|TSB|Tech Tip|bulletin)[^()]*\)\s*$/i, '').split(/;\s*/).filter(x => !/by me|not re-?downloaded|TODO|verify|snippet|search result|not fetched|upgrade to|internal/i.test(x)).join('; ').trim(); return !t || /models listed|universal|all obd|wording of the generic/i.test(t) || !/\d{4}|\d{2}-\d{2}/.test(t) ? null : t; };
// The earliest retrieval date among the documents actually cited on this page —
// "source documents read" has to mean this page's sources, not the site's newest fetch.
const sourceDates = [...(i.causes || []), ...(i.urgency || []), ...(i.guidance || []), ...(i.firstStep ? [i.firstStep] : []), ...(i.definition ? [i.definition] : [])].map(x => x?.fetched).filter(Boolean).sort();
const sourceDate = sourceDates.at(-1) || null;
const toc = [...(hasActionPlan(i) ? [['#what-to-do', 'What to do']] : []), ['#quick', 'Quick answer'], ...(causes.length ? [['#causes', 'Possible causes']] : []), ...(stats ? [['#nhtsa', 'NHTSA statistics']] : []), ...(related.length ? [['#related', 'Related codes']] : []), ...(vehicles.length ? [['#vehicles', 'Vehicles']] : []), ['#sources', 'Sources']];
const docLine = c => `${c.maker ? c.maker + "'s " : ''}${c.docKind}`;
---
<Base title={title} description={desc} path={path} jsonld={jsonld} crumbs={crumbs} nav={code ? 'codes' : 'symptoms'}>
<div class="container"><div class="phead" style="padding-bottom:20px">
<nav class="crumbs" aria-label="Breadcrumb">{crumbs.map((c, n) => <>{n > 0 && <span class="sep">/</span>}{n < crumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</>)}</nav>
<div class="eyebrow" style="margin-top:8px">{code ? 'OBD-II trouble code' : 'Symptom'}</div>
<h1 class="ptitle">{h1}</h1>
{code && altSuffix && <p class="section__kicker" style="margin-top:8px">Also written <b>{i.altSpellings.join(', ')}</b> — the second character is a zero (0), not the letter O. It is the same code with the same definition.</p>}
<ActionPlan i={i} ref={r} />
<section class="qa" id="quick" data-copy-scope aria-label="Quick answer">
  <div class="qa__head"><h2 class="qa__title">Quick answer</h2><Tools /></div>
  {code && <div class="qa__item" style="border-bottom:1px solid var(--border)"><div class="qa__q">What it means</div>
    {def ? <><div class="qa__a qa__a--text">{def.value}<sup class="ref"><a href={`#ref-${r(def)}`}>[{r(def)}]</a></sup></div>{def.sourceText && def.sourceText.replace(/^P\d{4}:\s*/, '') !== def.value && <div class="qa__src qa__src--wording">Source wording: “{def.sourceText}”</div>}<div class="qa__src">Wording from {def.document}{def.page && <>, <span class="pref">{def.page}</span></>}</div></> : <div class="qa__a qa__a--text"><span class="nv">Not yet verified — source pending</span></div>}</div>}
  <div class="qa__grid">
    <div class="qa__item"><div class="qa__q">Can I keep driving?</div>
      {top.length ? top.map(u => <><div class="qa__a qa__a--text qa__a--drive">{u.text}<sup class="ref"><a href={`#ref-${r(u)}`}>[{r(u)}]</a></sup></div><div class="qa__src"><span class={`ev ev--${tierOf(u)}`}>{TIER_SHORT[tierOf(u)]}</span> {u.document}{u.page && <>, <span class="pref">{u.page}</span></>} · applies to all {i.type === 'code' ? 'OBD-II ' : ''}vehicles</div></>)
       : <div class="qa__a qa__a--text"><span class="nv">Not yet verified — no all-vehicle source has been checked yet</span></div>}
      {brandLines.length > 0 && <div class="qa__brands">
        <div class="qa__src qa__brands-h">Only for the specific vehicles listed — not general advice:</div>
        {brandLines.map(b => <div class="qa__brand"><span class="tag tag--na">{scopeTag(b)}</span> {b.text}<sup class="ref"><a href={`#ref-${r(b)}`}>[{r(b)}]</a></sup></div>)}
      </div>}
    </div>
    <div class="qa__item"><div class="qa__q">{code ? 'What this code alone can’t tell you' : 'What a symptom alone can’t tell you'}</div>
      {urgency.length
        ? urgency.map(u => <><div class="qa__a qa__a--text">{u.text}<sup class="ref"><a href={`#ref-${r(u)}`}>[{r(u)}]</a></sup></div><div class="qa__src"><span class={`ev ev--${tierOf(u)}`}>{TIER_SHORT[tierOf(u)]}</span> {u.document}{u.page && <>, <span class="pref">{u.page}</span></>}{u.allBrands && <> · applies to all vehicles</>}</div></>)
        : <><div class="qa__a qa__a--text"><span class="tag tag--na">Not rated</span></div>
      <div class="qa__more">Severity is rated only when a checked source states it — none of the documents for {label} does, so we do not guess.</div></>}
      {i.firstStep?.text && i.firstStep?.url
        ? <div class="qa__more">Check first: {i.firstStep.text}<sup class="ref"><a href={`#ref-${r(i.firstStep)}`}>[{r(i.firstStep)}]</a></sup></div>
        : <div class="qa__more">What to check first: <span class="nv">Not yet verified — source pending</span></div>}
      <div class="qa__more">What a repair will cost varies by vehicle, region and shop, and no official source publishes a price for a single fault — so this site does not estimate one. We publish only figures we can trace to an official document{stats && <>; for the federal statistics that do exist, see <a href="#nhtsa">NHTSA statistics</a></>}.</div>
    </div>
    {i.firstStep?.text && i.firstStep?.url && <div class="qa__item"><div class="qa__q">Shop visit or check it yourself first?</div>
      <div class="qa__a qa__a--text">{i.firstStep.text}<sup class="ref"><a href={`#ref-${r(i.firstStep)}`}>[{r(i.firstStep)}]</a></sup></div>
      <div class="qa__src">{i.firstStep.document}{i.firstStep.page && <>, <span class="pref">{i.firstStep.page}</span></>}</div>
    </div>}
  </div>
  <div class="qa__foot"><span>Review record: <a href="#review">3 dates</a></span><a href="#report">Report a data error</a></div>
</section>
<div id="review"><ReviewDates source={sourceDate} reviewed={i.signOff?.date} by={i.signOff?.by} changed={i.dataUpdated} path={path} /></div>
</div>
<div class={`layout${toc.length >= 2 ? "" : " layout--single"}`}><div class="main">
{causes.length > 0 && <section id="causes" data-copy-scope>
  <div class="section__head"><div><h2 class="section__title">Possible causes</h2><p class="section__kicker">Each cause comes from a manufacturer document and applies to the models listed. Your vehicle may differ. <span class="evlegend">Sources are labelled: <span class="ev ev--oem">Manufacturer</span> <span class="ev ev--gov">Government</span> <span class="ev ev--guidance">Safety guidance</span></span></p></div><Tools /></div>
  <ol class="causes">{causes.map(c => <li>
    <div class="cause__src"><span class={`ev ev--${tierOf(c)}`}>{TIER_SHORT[tierOf(c)]}</span> <strong>{docLine(c).replace(/^./, m => m.toUpperCase())} ({c.document}{c.page && <>, <span class="pref">{c.page}</span></>})</strong> <sup class="ref"><a href={`#ref-${r(c)}`}>[{r(c)}]</a></sup></div>
    <div>{c.text}</div>
    {seenOn(c) && <div class="cause__seen"><span class="cause__seen-k">Seen on:</span> {seenOn(c)}</div>}
  </li>)}</ol>
</section>}
{stats && <section id="nhtsa">
  <div class="section__head"><div><h2 class="section__title">NHTSA statistics</h2><p class="section__kicker">How often {i.code} shows up in the federal complaint and recall databases.</p></div><Tools /></div>
  <div class="keyspecs" style="grid-template-columns:repeat(2,1fr)">
    <div class="ks"><div class="ks__label">Complaints that mention {i.code}</div>
      <div class="ks__val">{nf(stats.complaintsMentioning)}</div>
      <div class="ks__src">out of {nf(stats.complaintsTotal)} complaints in NHTSA's database<sup class="ref"><a href={`#ref-${r({ url: stats.source, document: 'NHTSA ODI complaint flat file (FLAT_CMPL.zip)', fetched: stats.fetched })}`}>[{r({ url: stats.source, document: 'NHTSA ODI complaint flat file (FLAT_CMPL.zip)', fetched: stats.fetched })}]</a></sup></div>
    </div>
    <div class="ks"><div class="ks__label">Recall campaigns that cite {i.code}</div>
      <div class="ks__val">{nf(stats.recallsMentioning)}</div>
      <div class="ks__src">out of {nf(stats.recallsTotal)} campaigns since 1967 — recall summaries describe defects in consumer terms and do not list diagnostic codes<sup class="ref"><a href={`#ref-${r({ url: stats.sourceRecalls, document: 'NHTSA ODI recall flat file (FLAT_RCL_POST_2010.zip)', fetched: stats.fetched })}`}>[{r({ url: stats.sourceRecalls, document: 'NHTSA ODI recall flat file (FLAT_RCL_POST_2010.zip)', fetched: stats.fetched })}]</a></sup></div>
    </div>
  </div>
  <p class="ks__src" style="margin-top:var(--sp-4)">How this is counted: {stats.method}. Complaints are voluntary and unverified — a mention is not proof that {i.code} caused the problem. Neither file contains repair-price data, which is why this site does not publish cost estimates.</p>
</section>}
{related.length > 0 && <section id="related"><div class="section__head"><div><h2 class="section__title">Related</h2></div></div><ul class="plist">{related.map(x => <li><a href={issueUrl(x)}>{x.type === 'code' ? `${x.code} code` : x.title}</a></li>)}</ul></section>}
{vehicles.length > 0 && <div class="m-only"><section id="vehicles"><div class="section__head"><div><h2 class="section__title">Vehicles we have specs for</h2></div></div><ul class="plist">{vehicles.map(v => <li><a href={vehicleUrl(v)}>{v.year} {v.make} {v.model} specs</a></li>)}</ul></section></div>}
<Feedback path={path} />
<section id="sources"><div class="section__head"><div><h2 class="section__title">Sources</h2></div></div>
<ol class="refs">{refs.map((x, n) => <li id={`ref-${n + 1}`}><a href={x.url} rel="nofollow noopener">{x.label}</a></li>)}</ol>
<p class="ks__src">General information from manufacturer documents, not professional mechanical advice. See <a href="/sources/">Data sources</a>.</p></section>
</div>
{toc.length >= 2 && <aside class="side"><nav class="toc" aria-label="On this page"><h2 class="toc__title">On this page</h2><ul>{toc.map(([h, t]) => <li><a href={h}>{t}</a></li>)}</ul></nav></aside>}</div></div>
</Base>
