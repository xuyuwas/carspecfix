---
import Page from '../layouts/Page.astro';
import { liveIssues, issueUrl } from '../lib/gate.mjs';
const { type } = Astro.props; const code = type === 'code';
const list = liveIssues.filter(i => i.type === type);
const path = code ? '/codes/' : '/symptoms/';
---
<Page narrow={true} title={code ? 'OBD-II Codes: Meaning & Can You Still Drive? | CarSpecFix' : 'Car Symptoms: Causes & Is It Safe to Drive? | CarSpecFix'}
  description={code ? 'OBD-II trouble codes: what each code means, whether you can keep driving, and causes from manufacturer service bulletins.' : 'Common car symptoms: whether it is safe to keep driving and causes from manufacturer documents.'}
  path={path} nav={code ? 'codes' : 'symptoms'} crumbs={[{ name: 'Home', url: '/' }, { name: code ? 'Trouble codes' : 'Symptoms', url: path }]} h1={code ? 'OBD-II trouble codes' : 'Car symptoms'}>
{list.length ? <ul class="links">{list.map(i => <li><a href={issueUrl(i)}>{code ? `${i.code} code` : i.title}</a>{code && i.definition?.value && <span class="links__sub"> — {i.definition.value}</span>}</li>)}</ul>
  : <p>Pages appear here once their sources are checked and signed off.</p>}
<p style="margin-top:16px">Wondering what the fix will cost? <a href="/repair-cost/">How to estimate it</a> — and why this site does not print per-repair estimates.</p>
</Page>
