---
import Base from '../../../../../layouts/Base.astro';
import Tools from '../../../../../components/Tools.astro';
import Feedback from '../../../../../components/Feedback.astro';
import Photo from '../../../../../components/Photo.astro';
import ConfigPicker from '../../../../../components/ConfigPicker.astro';
import ReviewDates from '../../../../../components/ReviewDates.astro';
import { liveVehicles, liveIssues, liveHubs, vehicleUrl, issueUrl, sources, hasVal, shownTireRows, placardNote, SITE, pageChanged } from '../../../../../lib/gate.mjs';
import { fitTitle, usOnly } from '../../../../../lib/title.mjs';
import { makeRefs, SEGMENT } from '../../../../../lib/refs.mjs';
import { imageObject } from '../../../../../lib/images.mjs';
import { parseOilCapacity } from '../../../../../lib/oil.mjs';
import { configModel, configNarrows } from '../../../../../lib/config.mjs';
import { AUTHOR } from '../../../../../lib/site.mjs';
export function getStaticPaths() {
  return liveVehicles.map(v => ({ params: { make: v.makeSlug, model: v.modelSlug, year: String(v.year) }, props: { v } }));
}
const { v } = Astro.props;
const s = v.specs, ev = v.powertrain === 'ev';
const name = `${v.year} ${v.make} ${v.model}`, path = vehicleUrl(v), updated = pageChanged(v);
const A = f => hasVal(f) && f.source && f.sourceGrade === 'A';      // only grade A values are shown
const { list: refs, ref } = makeRefs();
const srcRef = id => ref(id, sources[id]?.name + (sources[id]?.retrieved ? `, retrieved ${sources[id].retrieved}` : ''), sources[id]?.url);
const hub = liveHubs().find(h => h.makeSlug === v.makeSlug && h.modelSlug === v.modelSlug);
const siblings = liveVehicles.filter(x => x.modelSlug === v.modelSlug && x.makeSlug === v.makeSlug && x.slug !== v.slug).sort((a, b) => a.year - b.year);
const related = liveIssues.filter(i => v.related?.issues?.includes(i.slug));       // R-L2: data-driven only
const tires = shownTireRows(v);
// Some OEMs (GM, Ford) print no psi figure in the manual at all — it lives on the
// Tire and Loading Information label. That case is cited, not guessed.
const placard = placardNote(v);
const psiMissing = tires.length === 0 || tires.some(t => !(t.frontPsi && t.rearPsi));
const psiAllMissing = tires.length > 0 && tires.every(t => !(t.frontPsi && t.rearPsi));
// Math.min() of an empty array is Infinity and Math.max() is -Infinity. That is
// exactly how the 2022 Equinox shipped "Infinity–-Infinity psi": every one of its tyre
// rows carries a size and no pressure, because Chevrolet prints the pressure on the
// door-jamb label only. A page with no printed figure has to say so, not print a range.
const psis = tires.flatMap(t => [t.frontPsi, t.rearPsi]).filter(Boolean);
const pMin = psis.length ? Math.min(...psis) : null, pMax = psis.length ? Math.max(...psis) : null;
const psiText = pMin == null ? null : pMin === pMax ? `${pMin}` : `${pMin}–${pMax}`;
const hasPsiFigures = pMin != null;
// oil: single parser shared with the year hub page (lib/oil.mjs). It merges the
// "with filter; without" pair of one engine into a single entry — the old inline
// copy skipped that merge and rendered "null qt without" on the 2020/2024 RAV4.
const noRefs = t => String(t || '').replace(/\s*\[[A-Z0-9]{6,}[^\]]*\]/g, '').trim();
const oilEngines = A(s.oilCapacity) ? parseOilCapacity(s.oilCapacity.value) : [];
// The card shows every engine's with-filter and without-filter figures side by side.
// There is deliberately no single "headline" number: a top-level figure has to pick
// one condition, and whichever it picks is wrong for the reader who wanted the other.
const qt = n => Number.isInteger(n) ? n.toFixed(1) : String(n);   // 6.0 qt stays 6.0, 7.75 stays 7.75
const oilMissingWo = oilEngines.some(o => !o.unverified && o.w != null && o.wo == null);
const oilMissingW = oilEngines.some(o => !o.unverified && o.wo != null && o.w == null);
const sentence = t => (t || '').split(/\s*:\s*/).map(x => x.toLowerCase().replace(/\b(abs|nhtsa|tpms|led|esc|ecm|pcm|usb|hvac|egr|evap)\b/g, m => m.toUpperCase())).join(': ').replace(/^./, m => m.toUpperCase());
const esc = x => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const P = t => esc(String(t || '')).replace(/\bpp?\.\s?[\d–-]+(?:[,\/]\s?[\d–-]+)*/g, m => `<span class="pref">${m}</span>`);
const samePsi = tires.length > 0 && tires.every(t => t.frontPsi === tires[0].frontPsi && t.rearPsi === tires[0].rearPsi);
const oilLines = oilEngines.map(o => o.raw);            // detail table: one line per engine, verbatim from the manual
// Card rows: one per engine, both conditions shown when the manual prints both.
// A condition the manual never states stays absent (a footnote explains it) —
// it is never filled in from the other condition.
const oilCard = oilEngines.map(o => {
  // The label is rendered on its own line, so the verbatim string must not repeat it.
  const raw = o.label && o.raw.startsWith(o.label) ? o.raw.slice(o.label.length).replace(/^:\s*/, '') : o.raw;
  return {
    label: o.label,
    w: o.unverified ? null : o.w,
    wo: o.unverified ? null : o.wo,
    raw,
    blank: o.unverified || (o.w == null && o.wo == null),
  };
});
// EV pages carry no oilCapacity field at all — optional chaining keeps them renderable.
const oilApplies = s.oilCapacity?.appliesTo ? `Applies to: ${s.oilCapacity.appliesTo}.` : '';
const oilUnver = s.oilCapacity?.unverifiedNote || '';
const oilScope = [oilApplies, oilUnver].filter(Boolean).join(' ');
const recallsSorted = [...v.recalls].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const nhtsaRef = ref('nhtsa', `NHTSA recalls database, ${name}, fetched ${v.recallsFetched}`, v.recallsUrl);
const feRef = v.fuelEconomy.length ? ref('fe', `fueleconomy.gov (U.S. EPA / DOE), ${name}, fetched ${v.fuelEconomyFetched}`, `https://www.fueleconomy.gov/feg/PowerSearch.do?action=noform&path=1&year1=${v.year}&year2=${v.year}&make=${encodeURIComponent(v.make)}`) : null;
const oilRef = A(s.oilCapacity) ? srcRef(s.oilCapacity.source) : null;
// page ref like "Tesla Owner's Manual (…, online): Wheels and Tires" -> column shows the section; full manual name goes to Sources once
const pgShow = pg => pg && pg.includes(': ') ? pg.slice(pg.lastIndexOf(': ') + 2) : pg;
const pgList = arr => { const u = [...new Set(arr.filter(Boolean))]; const nums = [...new Set(u.filter(x => /^p\.\d+$/.test(x)).map(x => +x.slice(2)))].sort((a, b) => a - b); const other = u.filter(x => !/^p\.\d+$/.test(x));
  const rs = []; for (const n of nums) { const r = rs[rs.length - 1]; if (r && n === r[1] + 1) r[1] = n; else rs.push([n, n]); }
  const txt = rs.map(([a, b]) => a === b ? `${a}` : `${a}–${b}`); const many = nums.length > 1;
  return [...(txt.length ? [`${many ? 'pp.' : 'p.'} ${txt.join(', ')}`.replace(/^p\. /, 'p.')] : []), ...other].join(', '); };
const pgDocs = [...new Set(tires.map(t => t.page).filter(pg => pg && pg.includes(': ')).map(pg => pg.slice(0, pg.lastIndexOf(': '))))];
const tireRef = tires.length ? srcRef(tires[0].source) : null;
const placardRef = placard ? srcRef(placard.source) : null;
// Title/meta: only modules really on the page (R-M2 v2)
// A page may pin its own title/description/H1 (data: seo{}) when Search Console
// shows it earns impressions on a phrase the generic formula does not carry. Every
// other page keeps the formula, so the site never drifts title by title.
const seo = v.seo || {};
// Titles for pages that do print psi stay byte-identical to before; only the placard
// case (no psi anywhere in the manual) needs a different wording.
// An EV has no engine oil at all, so the shared formula would put "Oil" in the title of
// a page that has no oil section to answer it. Title each kind of page with what it
// actually covers; everything else keeps the one formula, so titles never drift.
const autoTitle = ev
  ? `${v.year} ${v.make} ${v.model} Specs: Tire Sizes, Pressure${v.recalls.length ? ' & Recalls' : ''}`
  : placard && psiAllMissing
    ? `${v.year} ${v.make} ${v.model} Specs: Oil, Tire Sizes${v.recalls.length ? ', Recalls' : ''}`
    : `${v.year} ${v.make} ${v.model} Specs: Oil, Tire Size & Pressure`;
const title = seo.title || autoTitle;
// description: drop detail progressively until it fits 160 chars (R-M1)
// First variant only, engine label stripped, then cut at the first parenthesis or comma.
// Splitting on "(" before removing the label used to leave the bare label behind
// ("2.5L 4-cylinder (2AR-FE): SAE 5W-20" -> "2.5L 4-cylinder") and that leaked into the
// meta description as "…with filter, 2.5L 4-cylinder".
const visc = A(s.oilViscosity) ? (() => {
  const firstSeg = noRefs(s.oilViscosity.value).split(/\s*;\s*|\s+\|\s+/)[0];
  const noLabel = firstSeg.includes(':') ? firstSeg.slice(firstSeg.indexOf(':') + 1) : firstSeg;
  // Prefer the bare code when the sentence qualifies it ("5W-20 or 0W-20"): the meta is 160 chars.
  const code = noLabel.match(/(?:SAE\s*)?\d{1,2}W-\d{2}/i);
  return (code ? code[0] : noLabel.split(/[(,]/)[0]).trim();
})() : '';
const oilPhrase = l => { const m = l.match(/^([^:]+):\s*(.*)$/); return m ? `${m[1]} oil: ${m[2]}` : `oil ${l}`; };
const oilFull = oilLines.length ? `${oilPhrase(oilLines[0])}${visc ? ', ' + visc : ''}` : null;
// verbatim from the source: first variant's first amount (up to the first comma), no recalculation or rewording
const oilRawFirst = A(s.oilCapacity) ? noRefs(s.oilCapacity.value).split(/\s*;\s*|\s+\|\s+/)[0].split(/,\s*/)[0].trim() : '';
const oilShort = oilRawFirst ? `${oilPhrase(oilRawFirst)}${visc ? ', ' + visc : ''}` : null;
const tireBit = tires.length ? (placard && psiAllMissing ? `tire sizes for ${tires.length} wheel options` : samePsi ? `${tires[0].frontPsi} psi front / ${tires[0].rearPsi} psi rear (${tires[0].tireSize})` : `tire size & pressure for ${tires.length} wheel configurations`) : null;
const tireShort = tires.length ? (placard && psiAllMissing ? 'tire sizes by wheel' : 'tire size & pressure by wheel') : null;
const recBit = v.recalls.length ? `${v.recalls.length} NHTSA recall${v.recalls.length > 1 ? 's' : ''}` : null;
const mk = parts => `${name}: ${parts.filter(Boolean).join('; ')}. Manual page cited.`;
// Last resort, when even the shortest oil-first variant runs past 160 chars: an EV has
// no oil row to promise, so it falls back to the tire line alone.
const descLast = ev ? mk([tireShort ?? 'factory tire sizes']) : mk(['oil capacity & type', tireShort]);
const autoDesc = [mk([oilFull, tireBit, recBit]), mk([oilShort, tireBit, recBit]), mk([oilShort, tireShort, recBit]), mk([oilShort, tireShort]), descLast].find(d => d.length <= 160) ?? descLast;
// A page may pin its own title/description/H1 (data: seo{}) when Search Console
// shows it earns impressions on a phrase the generic formula does not carry. Every
// other page keeps the formula, so the site never drifts title by title.
const desc = seo.description || autoDesc;
const other = [['Towing', s.towingCapacity], ['12V battery (group / type)', s.batteryGroup], ['TPMS reset', s.tpmsReset], ['12V battery', s.battery12v], ['Wiper blade sizes', s.wiperSizes]].filter(([, f]) => A(f));
const segment = SEGMENT[v.modelSlug] || 'sedan';
const img = imageObject(v.slug, SITE);
const jsonld = [
  { '@type': 'Car', name, brand: { '@type': 'Brand', name: v.make }, model: v.model, vehicleModelDate: String(v.year), ...(img ? { image: img } : {}) },
  { '@type': 'Article', headline: `${name} Specs`, datePublished: v.publishDate ?? updated, dateModified: updated, author: { '@type': 'Person', name: AUTHOR.name, url: `${SITE}/authors/${AUTHOR.slug}/` }, mainEntityOfPage: SITE + path },
];
// Every crumb MUST carry a url: a ListItem without `item` is a Search Console
// "Missing field item" error. There is no make-level hub page, so make+model
// are merged into one crumb (and the year page stands alone when no hub exists).
const modelLabel = `${v.make} ${v.model}`;
const modelPath = `/specs/${v.makeSlug}/${v.modelSlug}/`;
const crumbs = [{ name: 'Home', url: '/' }, ...(hub ? [{ name: modelLabel, url: modelPath }] : []), { name: hub ? String(v.year) : `${v.year} ${modelLabel}`, url: path }];
const tabs = [['#quick', 'Quick answer'], ...(v.recalls.length ? [['#recalls', 'Recalls']] : []), ...(tires.length ? [['#tires', 'Tires']] : []), ...(oilLines.length ? [['#oil', 'Oil']] : []), ...(other.length ? [['#parts', 'Parts']] : []), ...(feRef ? [['#mpg', 'Fuel economy']] : []), ...(related.length ? [['#problems', 'Problems']] : []), ['#sources', 'Sources']];
const configs = [...new Set(v.fuelEconomy.map(c => c.drive.replace('Front-Wheel Drive', 'FWD').replace('All-Wheel Drive', 'AWD').replace(/4-Wheel.*|Part-time 4-Wheel Drive/, '4WD').replace('Rear-Wheel Drive', 'RWD')))];
// Per-record EPA link (the human-readable page for this exact configuration),
// so a reader can confirm the rating belongs to their engine/drive combination.
const feUrl = c => `https://www.fueleconomy.gov/feg/noframes/${c.feId}.shtml`;
const hasPowertrain = v.fuelEconomy.some(c => c.powertrain);   // gas vs hybrid split only when the data declares it
const pwLabel = p => p === 'hybrid' ? 'Hybrid' : p === 'gas' ? 'Gasoline' : p;
// "Source documents read" is the retrieval date of every document this page cites —
// not the site's newest fetch. When they differ, the range is shown, because a single
// date would imply all three were read on the same day.
const readDates = [...new Set([sources[s.oilCapacity?.source]?.retrieved, sources[s.oilViscosity?.source]?.retrieved, v.recallsFetched, v.fuelEconomyFetched].filter(Boolean))].sort();
// When the manual prints more than one oil figure or more than one tyre package, the
// selector above answers the question and the quick answer must NOT restate a range as
// if it were the answer. The cells are replaced by one that says why, and the numbers
// live in the selector and the tables below.
const cfgm = configModel(v);
const nr = configNarrows(cfgm);
const cfgUsable = nr.any, cfgOil = nr.oil, cfgPsi = nr.psi;
// Four states, and only one of them is a number. `label` is not a gap to be hidden: a
// manual that prints no psi table has a real answer ("read the door-jamb label"), and
// the 2022 Equinox lost it because the oil selector switched the whole cell off.
const psiAnswer = !hasPsiFigures ? (placard ? 'label' : 'unverified') : cfgPsi ? 'selector' : 'figure';
const wheelCount = [...new Set(tires.map(t => t.wheel).filter(Boolean))].length || tires.length;
const oilByDrive = cfgm.engines.some(e => (e.oilList || []).some(o => o.drive));
const psiDistinct = new Set(tires.filter(x => x.frontPsi && x.rearPsi).map(x => `${x.frontPsi}/${x.rearPsi}`)).size;
const psiOpen = !hasPsiFigures ? null
  : `It lists ${psiDistinct} different cold pressure${psiDistinct === 1 ? '' : 's'} across ${wheelCount} wheel size${wheelCount === 1 ? '' : 's'} and never says which trim gets which, so ${psiText} psi is the range for this model year, not your figure.`;
const oilOpen = cfgOil ? `Oil is printed per ${oilByDrive ? 'engine and drive' : 'engine'}: ${oilEngines.map(o => o.raw).join('; ')}.` : null;
const openLine = [psiOpen, oilOpen].filter(Boolean).join(' ');
const oilDocName = sources[s.oilCapacity?.source]?.name;
const tireDocName = tires.length ? sources[tires[0].source]?.name : null;
const sourceDate = readDates.length ? (readDates.length === 1 ? readDates[0] : `${readDates[0]} – ${readDates.at(-1)}`) : null;
---
<Base title={title} description={desc} path={path} jsonld={jsonld} crumbs={crumbs} nav="specs">
<div class="vhead vhead--compact"><div class="container">
<nav class="crumbs" aria-label="Breadcrumb">{crumbs.map((c, i) => <>{i > 0 && <span class="sep">/</span>}{c.url && i < crumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c.name}</span>}</>)}</nav>
<div class="vhead__grid" style="padding-bottom:0">
  <div><div class="eyebrow">{v.make}{configs.length > 0 && ` · ${configs.join(' / ')}`}</div><h1 class="vtitle"><span class="yr">{v.year} {v.make}</span>{seo.h1Tail ?? `${v.model} specs`}</h1></div>
  <div class="vart"><Photo slug={v.slug} year={v.year} name={`${v.make} ${v.model}`} segment={segment} hero={true} powertrain={v.powertrain} /></div>
</div>
<ConfigPicker v={v} />
<section class="qa" id="quick" data-copy-scope aria-label="Quick answer">
  <div class="qa__head"><h2 class="qa__title">Quick answer</h2><Tools /></div>
  <div class="qa__grid">
  {psiAnswer !== 'selector' && <div class="qa__item"><div class="qa__q">Tire pressure (cold)</div>
    {psiAnswer === 'label' ? <>
      <div class="qa__a qa__a--text">On the door-jamb label<sup class="ref"><a href={`#ref-${placardRef}`}>[{placardRef}]</a></sup></div>
      <div class="qa__more">{placard.note ?? `${v.make} publishes recommended cold pressures only on the Tire and Loading Information label, not in a psi table.`}</div>
      <div class="qa__src"><Fragment set:html={P(`Manual ${placard.page}`)} /> · check the label on your driver's door jamb for your exact trim.</div>
    </> : psiAnswer === 'unverified' ? <div class="qa__a qa__a--text"><span class="nv">Not yet verified — check your owner's manual</span></div>
     : <><div class="qa__a">{psiText}<small>psi{samePsi && tires[0].frontPsi !== tires[0].rearPsi ? ' front/rear' : ''}{!samePsi ? ', by wheel package' : ''}</small><sup class="ref"><a href={`#ref-${tireRef}`}>[{tireRef}]</a></sup></div>
        <div class="qa__more">{tires.slice(0, 3).map(t => <div>{t.config ?? `${t.wheel}-in`} ({t.tireSize}): <b>{t.frontPsi === t.rearPsi ? t.frontPsi : `${t.frontPsi}/${t.rearPsi}`} psi</b></div>)}{tires.length > 3 && <a href="#tires">See all {tires.length} →</a>}</div>
        {!samePsi && <div class="qa__more qa__more--split"><b>Not one number.</b> This manual prints a pressure per wheel/tyre package and never maps a package to a trim, so the figure above is a range, not necessarily your answer. Pick your tyre size in the selector above to narrow it — and read the label on your driver's door jamb, which is the only place your exact build is named.</div>}</>}
    {!psiAllMissing && tires.length > 0 && <div class="qa__src">{[...new Set(tires.map(t => pgShow(t.page)).filter(Boolean))].length ? <>Manual <Fragment set:html={P(pgList(tires.map(t => pgShow(t.page))))} /> · </> : ''}Check the tire placard on your driver's door jamb for your exact trim.</div>}
  </div>}
  {!ev && !cfgOil && <div class="qa__item"><div class="qa__q">Engine oil</div>
    {oilScope && <div class="qa__src qa__applies">{oilScope}</div>}
    {oilLines.length ? <>
      <div class="oil">{oilCard.map(r => <div class="oil__row">
        {r.label && <div class="oil__eng">{r.label}</div>}
        {r.blank ? <div class="oil__fig oil__fig--nv"><span class="nv">{r.raw}</span></div>
         : <div class="oil__pairs">
             {r.w != null && <div class="oil__fig"><b>{qt(r.w)}<small>qt</small></b><em>with filter</em></div>}
             {r.wo != null && <div class="oil__fig"><b>{qt(r.wo)}<small>qt</small></b><em>without filter</em></div>}
           </div>}
      </div>)}</div>
      <div class="qa__src"><a href="#oil">See the full table</a><sup class="ref"><a href={`#ref-${oilRef}`}>[{oilRef}]</a></sup></div>
      {(oilMissingWo || oilMissingW) && <div class="qa__src">{oilMissingWo ? 'Without-filter amount not stated in the manual for these engines.' : 'With-filter amount not stated in the manual for these engines.'}</div>}
      <div class="qa__more">{A(s.oilViscosity) ? <b>{noRefs(s.oilViscosity.value)}</b> : <span class="nv">Viscosity: Not yet verified</span>}</div>
      <div class="qa__src"><Fragment set:html={P([s.oilCapacity.page && `Manual ${s.oilCapacity.page} (capacity)`, A(s.oilViscosity) && s.oilViscosity.page && `${s.oilViscosity.page} (viscosity)`].filter(Boolean).join(', ') || `Source [${oilRef}]`)} /></div>
    </> : <div class="qa__a qa__a--text"><span class="nv">Not yet verified — check your owner's manual</span></div>}
  </div>}
  {cfgUsable && <div class="qa__item"><div class="qa__q">What the manual leaves open</div>
    <div class="qa__a qa__a--text">Which build gets which figure</div>
    <div class="qa__more">{openLine}{!hasPsiFigures && placard ? <>{' '}{v.make} prints no psi table for this model year at all — the cold pressure is on the Tire and Loading Information label on the driver's door jamb.</> : null} The tyre size on the sidewall and the label on the driver's door jamb are the only places your exact build is named.</div>
    <div class="qa__src">Pick {[cfgOil ? (oilByDrive ? 'the engine and drive' : 'the engine') : null, cfgPsi ? 'the tyre size' : null].filter(Boolean).join(' and ')} in the selector above to narrow it. Nothing here is averaged or carried over from another year.</div>
  </div>}
  <div class="qa__item"><div class="qa__q">Recalls</div>
    <div class="qa__a">{v.recalls.length}<small>NHTSA campaigns</small><sup class="ref"><a href={`#ref-${nhtsaRef}`}>[{nhtsaRef}]</a></sup></div>
    <div class="qa__more">{v.recalls.length > 0 && <><a href="#recalls">See campaign list</a> · </>}check your own car by VIN at <a href="https://www.nhtsa.gov/recalls" rel="nofollow noopener">nhtsa.gov/recalls</a></div>
    <div class="qa__src">Fetched {v.recallsFetched}</div>
  </div>
  {cfgUsable && <div class="qa__item"><div class="qa__q">Where the figures come from</div>
    <div class="qa__a qa__a--text">Cited page by page</div>
    <div class="qa__more">{oilLines.length ? <>Oil: {oilDocName ?? "owner's manual"}{' '}{s.oilCapacity.page}<br /></> : null}{tires.length ? <>Tires: {tireDocName ?? "owner's manual"}{' '}{pgList(tires.map(t => pgShow(t.page)))}<br /></> : null}<a href="#sources">Full source list</a></div>
    <div class="qa__src">One printed row per configuration — no value on this page is calculated, averaged or carried over from another year.</div>
  </div>}
  </div>
  <div class="qa__foot"><span>Review record: <a href="#review">3 dates</a> — source read, human review, last change</span><a href="#report">Report a data error</a></div>
</section>
<div id="review"><ReviewDates source={sourceDate} reviewed={v.signOff?.date} by={v.signOff?.by} changed={updated} path={path} /></div>
<div class="vart-m"><Photo slug={v.slug} year={v.year} name={`${v.make} ${v.model}`} segment={segment} hero={false} powertrain={v.powertrain} /></div>
{siblings.length > 0 && <div class="vmeta" style="margin:16px 0 0"><div class="chips"><span class="vmeta__label">Year</span>{[...siblings, v].sort((a, b) => a.year - b.year).map(x => x.slug === v.slug ? <span class="chip" aria-current="page">{x.year}</span> : <a class="chip chip--muted" href={vehicleUrl(x)}>{x.year}</a>)}</div></div>}
</div></div>
<nav class="subnav" aria-label="On this page"><div class="container subnav__in">{tabs.map(([h, t], i) => <a href={h} aria-current={i === 0 ? 'true' : undefined}>{t}</a>)}</div></nav>
<div class="container"><div class={`layout${tabs.length >= 2 ? '' : ' layout--single'}`}><div class="main">
{v.recalls.length > 0 && <section id="recalls" data-copy-scope>
  <div class="section__head"><div><h2 class="section__title">Recalls ({v.recalls.length})</h2><p class="section__kicker">Check your own vehicle by VIN at nhtsa.gov/recalls</p></div><Tools /></div>
  <div class="tbl-wrap"><div class="tbl-scroll" role="region" tabindex="0" aria-label="Recalls table"><table class="tbl"><thead><tr><th scope="col">Campaign</th><th scope="col">Component</th><th scope="col">Report date</th></tr></thead>
  <tbody>{recallsSorted.map(r => <tr><td class="nowrap"><span class="mono">{r.campaign}</span></td><td>{sentence(r.component)}</td><td class="nowrap"><span class="tnum">{r.date}</span></td></tr>)}</tbody></table></div>
  <div class="swipe">Swipe for more columns</div></div>
</section>}
{tires.length > 0 && <section id="tires" data-copy-scope>
  <div class="section__head"><div><h2 class="section__title">Tire size &amp; pressure by configuration</h2><p class="section__kicker">One row per wheel / configuration, as worded in the owner's manual.{v.tires?.note ? ` ${v.tires.note}` : ''}{psiAllMissing && placard ? ` ${v.make} prints no psi table: cold pressures are on the Tire and Loading Information label (manual ${placard.page}).` : ' Check the tire placard on your driver\'s door jamb for your exact trim.'}</p></div><Tools /></div>
  <div class="tbl-wrap"><div class="tbl-scroll" role="region" tabindex="0" aria-label="Tire table"><table class="tbl tbl--wide"><thead><tr><th scope="col">Wheel</th><th scope="col">Trim / config</th><th scope="col">Tire size</th><th scope="col" class="num">Front psi</th><th scope="col" class="num">Rear psi</th><th scope="col">Source</th></tr></thead>
  <tbody>{tires.map(t => <tr><td class="nowrap strong">{t.wheel ? `${t.wheel}-in` : '—'}</td><td>{t.config ?? 'All'}</td><td class="big">{t.tireSize ?? <span class="nv">Not yet verified</span>}</td><td class="num">{t.frontPsi ?? (placard ? <span class="pg">see label</span> : <span class="nv">Not yet verified</span>)}</td><td class="num">{t.rearPsi ?? (placard ? <span class="pg">see label</span> : <span class="nv">Not yet verified</span>)}</td><td class="pg">{t.page ? <span class="pref">{pgShow(t.page)}</span> : '—'}</td></tr>)}</tbody></table></div>
  <div class="swipe">Swipe for more columns</div></div>
</section>}
{oilLines.length > 0 && <section id="oil" data-copy-scope>
  <div class="section__head"><div><h2 class="section__title">Engine oil</h2><p class="section__kicker">One line per engine</p></div><Tools /></div>
  <div class="kv">
    {oilLines.map(l => <div class="kv__row"><div class="kv__k">Oil capacity</div><div class="kv__v"><span class="kv__fig">{l}<sup class="ref"><a href={`#ref-${oilRef}`}>[{oilRef}]</a></sup></span><span class="kv__src">Source [{oilRef}]{s.oilCapacity.page && <> · manual <span class="pref">{s.oilCapacity.page}</span></>}</span></div></div>)}
    <div class="kv__row"><div class="kv__k">Oil viscosity</div><div class="kv__v">{A(s.oilViscosity) ? <><span class="kv__fig">{noRefs(s.oilViscosity.value)}<sup class="ref"><a href={`#ref-${srcRef(s.oilViscosity.source)}`}>[{srcRef(s.oilViscosity.source)}]</a></sup></span><span class="kv__src">Source [{srcRef(s.oilViscosity.source)}]{s.oilViscosity.page && <> · manual <span class="pref">{s.oilViscosity.page}</span></>}</span></> : <span class="nv">Not yet verified — check your owner's manual</span>}</div></div>
  </div>
</section>}
{other.length > 0 && <section id="parts" data-copy-scope>
  <div class="section__head"><div><h2 class="section__title">Parts &amp; capacities</h2></div><Tools /></div>
  <div class="kv">{other.map(([k, f]) => <div class="kv__row"><div class="kv__k">{k}</div><div class="kv__v"><span class="kv__fig">{usOnly(noRefs(f.value))}<sup class="ref"><a href={`#ref-${srcRef(f.source)}`}>[{srcRef(f.source)}]</a></sup></span></div></div>)}</div>
</section>}
{feRef && <section id="mpg" data-copy-scope>
  <div class="section__head"><div><h2 class="section__title">Fuel economy</h2><p class="section__kicker">EPA city / highway / combined, US mpg{ev && ' equivalent (MPGe)'}{hasPowertrain && ' — gasoline and hybrid configurations are listed separately; match the engine and drive of your car'}</p></div><Tools /></div>
  <div class="tbl-wrap"><div class="tbl-scroll" role="region" tabindex="0" aria-label="Fuel economy table"><table class="tbl"><thead><tr><th scope="col">Model</th><th scope="col" class="wrap">Engine / transmission</th><th scope="col">Drive</th>{hasPowertrain && <th scope="col">Powertrain</th>}<th scope="col" class="num">City</th><th scope="col" class="num">Hwy</th><th scope="col" class="num">Combined</th></tr></thead>
  <tbody>{v.fuelEconomy.map(c => <tr><td class="strong nowrap"><a href={feUrl(c)} rel="nofollow noopener">{c.model}</a></td><td class="wrap">{c.option}</td><td class="nowrap">{c.drive}</td>{hasPowertrain && <td class="nowrap">{pwLabel(c.powertrain)}</td>}<td class="num">{c.mpgCity}</td><td class="num">{c.mpgHwy}</td><td class="num">{c.mpgComb}</td></tr>)}</tbody></table></div>
  <div class="swipe">Swipe for more columns</div></div>
  <p class="ks__src">Each model name links to its own fueleconomy.gov record. Source [{feRef}]</p>
</section>}
{related.length > 0 && <section id="problems"><div class="section__head"><div><h2 class="section__title">Common problems</h2></div></div><ul class="plist">{related.map(i => <li><a href={issueUrl(i)}>{i.type === 'code' ? `${i.code} code` : i.title}</a></li>)}</ul></section>}
<Feedback path={path} />
<section id="sources"><div class="section__head"><div><h2 class="section__title">Sources</h2></div></div>
{(v.extraManuals || []).filter(u => !refs.some(x => x.url === u)).forEach(u => ref(u, `Toyota owner's manual ${(u.match(/(OM\w+)\.pdf/) || [])[1] || ''} (${v.year} ${v.model}, other production period; oil & tire tables identical for shared configurations)`, u))}
{pgDocs.forEach(d => ref('pgdoc:' + d, d, null))}
<ol class="refs">{refs.map((r, i) => <li id={`ref-${i + 1}`}>{r.url ? <a href={r.url} rel="nofollow noopener">{r.label}</a> : r.label}</li>)}</ol>
<p class="ks__src">How we collect and check data: <a href="/sources/">Data sources</a>.</p></section>
</div>
{tabs.length >= 2 && <aside class="side"><nav class="toc" aria-label="On this page"><h2 class="toc__title">On this page</h2><ul>{tabs.map(([h, t]) => <li><a href={h}>{t}</a></li>)}</ul></nav></aside>}</div></div>
</Base>
