---
import Page from '../../../../layouts/Page.astro';
import { liveHubs, vehicleUrl, shownTireRows, hasVal } from '../../../../lib/gate.mjs';
import { fitTitle } from '../../../../lib/title.mjs';
import { oilHubShort } from '../../../../lib/oil.mjs';
// R-U6: generated only with >=2 live years; links only to live years
export function getStaticPaths() { return liveHubs().map(h => ({ params: { make: h.makeSlug, model: h.modelSlug }, props: { h } })); }
const { h } = Astro.props; const v0 = h.years[0];
const name = `${v0.make} ${v0.model}`, path = `/specs/${h.makeSlug}/${h.modelSlug}/`;
const oil = y => hasVal(y.specs.oilCapacity) && y.specs.oilCapacity.sourceGrade === 'A' ? oilHubShort(y.specs.oilCapacity.value) : null;
const tires = y => [...new Set(shownTireRows(y).map(t => t.tireSize).filter(Boolean))].join(', ') || null;
const showDiff = h.years.filter(y => oil(y) || tires(y)).length >= 2;
---
<Page narrow={true} title={fitTitle(`${name} Specs by Year`, ['Oil', 'Tires', 'Recalls'])} description={`${name} specs for ${h.years.map(y => y.year).join(', ')}: oil capacity, tire size and pressure, and NHTSA recalls, each from the owner's manual or NHTSA.`} path={path} nav="specs" crumbs={[{ name: 'Home', url: '/' }, { name: v0.make }, { name: v0.model, url: path }]} h1={`${name} specs by year`}>
<ul class="links">{h.years.map(y => <li><a href={vehicleUrl(y)}>{y.year} {y.model} specs</a></li>)}</ul>
{showDiff && <><h2 class="section__title" style="margin-top:24px">What changed between years</h2>
<div class="tbl-wrap"><div class="tbl-scroll" role="region" tabindex="0" aria-label="Year comparison"><table class="tbl"><thead><tr><th>Year</th><th>Oil capacity (without filter)</th><th>Tire sizes</th><th class="num">Recalls</th></tr></thead>
<tbody>{h.years.map(y => <tr><td class="strong">{y.year}</td><td>{oil(y) ?? <span class="nv">Not yet verified</span>}</td><td>{tires(y) ?? <span class="nv">Not yet verified</span>}</td><td class="num">{y.recalls.length}</td></tr>)}</tbody></table></div></div></>}
</Page>
