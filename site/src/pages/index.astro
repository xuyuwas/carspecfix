---
import Base from '../layouts/Base.astro';
import Feedback from '../components/Feedback.astro';
import Photo from '../components/Photo.astro';
import { liveVehicles, liveIssues, liveHubs, vehicles, vehicleGate, vehicleUrl, issueUrl } from '../lib/gate.mjs';
import { SEGMENT } from '../lib/refs.mjs';
const codes = liveIssues.filter(i => i.type === 'code'), syms = liveIssues.filter(i => i.type === 'symptom');
const sorted = [...liveVehicles].sort((a, b) => a.make.localeCompare(b.make) || a.model.localeCompare(b.model) || b.year - a.year);
// Published counts are honest by construction: the gap between draft and live is
// shown, so a small library reads as "still being checked" rather than "thin".
const inReview = vehicles.filter(v => !vehicleGate(v).dataReady).length;
---
<Base title="Car Specs by Year, Make & Model: Oil, Tires, Recalls" description="Oil capacity and type, tire size and pressure, and NHTSA recalls by year, make and model, with the owner's-manual page cited for every number." path="/" nav="home">
<section class="finder"><div class="container"><h1>Car Specs by Year, Make &amp; Model: Oil, Tires, Recalls</h1><p>Oil capacity, tire pressure and recalls, with a source for every number.</p>
<div class="finder__tabs"><a href="#" aria-current="true">By vehicle</a>{liveIssues.some(x => x.type === "code") && <a href="/codes/">By trouble code</a>}</div>
{sorted.length > 0 && <form class="finder__form" data-goto><label class="field"><span>Vehicle</span><select name="u">{sorted.map(v => <option value={vehicleUrl(v)}>{v.year} {v.make} {v.model}</option>)}</select></label><button class="btn btn--accent btn--lg" type="submit">Show specs</button></form>}
<p class="finder__note">Live now: {sorted.length} vehicles and {codes.length} trouble codes{syms.length ? `, plus ${syms.length} symptom pages` : ''}.{' '}{inReview > 0 && <>{inReview} more are in source review — <a href="/specs/#in-review">see what is being checked</a>.</>}{' '}A page goes live only after every figure is source-checked — don't see yours? <a href="/contact/">Tell us what to add</a>.</p>
</div></section>
<div class="container">
<section class="hsec">
  <div class="hsec__head"><h2 class="section__title">What can CarSpecFix help you with?</h2></div>
  <ul class="usecases">
    <li><a href="/specs/honda/civic/2022/"><q>“How much oil does my 2022 Civic take — and what grade?”</q><p>Oil capacity and viscosity by engine, with the owner's-manual page cited for every figure.</p></a></li>
    <li><a href="/specs/toyota/rav4/2020/"><q>“What tires fit, and what's the cold pressure?”</q><p>Tire size by configuration; if the manual gives no pressure for your setup, it points you to the door-jamb label.</p></a></li>
    <li><a href="/specs/honda/civic/2022/"><q>“Any recalls on my car?”</q><p>Recall records for that year, make and model — then check your own VIN at NHTSA.</p></a></li>
    <li><a href="/codes/"><q>“What does P0300 / P0455 mean — can I still drive?”</q><p>What each code means, likely causes, and the difference between a solid and a flashing light. A code is not a diagnosis.</p></a></li>
    <li><a href="/symptoms/brakes-squeaking/"><q>“Squeaking or grinding when I brake?”</q><p>Source-backed next steps and the warning signs that mean stop driving — not a substitute for an inspection.</p></a></li>
    <li><a href="/repair-cost/"><q>“What should I expect to pay for the repair?”</q><p>No unverified estimates here, but how a bill breaks down and how to get comparable written quotes.</p></a></li>
  </ul>
</section>
<section class="hsec"><div class="hsec__head"><h2 class="section__title">Vehicles</h2></div>
{sorted.length ? <div class="vgrid">{sorted.map(v => <div class="vcard"><div class="vcard__art"><Photo slug={v.slug} year={v.year} name={`${v.make} ${v.model}`} segment={SEGMENT[v.modelSlug] || 'sedan'} sizes="(min-width:1024px) 288px, (min-width:640px) 45vw, 92vw" /></div><div class="vcard__body"><span class="vcard__yr">{v.year}</span><span class="vcard__name">{v.make} {v.model}</span><span class="vcard__meta">Oil · Tires · Recalls</span></div><a class="vcard__hit" href={vehicleUrl(v)}><span class="sr-only">{v.year} {v.make} {v.model} specs</span></a></div>)}</div> : <p>Vehicle pages are being checked.</p>}
{liveHubs().length > 0 && <ul class="links">{liveHubs().map(h => <li><a href={`/specs/${h.makeSlug}/${h.modelSlug}/`}>{h.years[0].make} {h.years[0].model}: all years</a></li>)}</ul>}
</section>
{syms.length > 0 ? <div class="split hsec">
<section><div class="hsec__head"><h2 class="section__title">Check a trouble code</h2></div><form class="code-form" data-code><label class="field"><span>OBD-II code</span><input class="mono" name="q" placeholder="P0455"></label><button class="btn btn--primary btn--lg" style="height:auto">Check code</button></form>
{codes.length > 0 && <ul class="links">{codes.map(i => <li><a href={issueUrl(i)}>{i.code} code</a></li>)}</ul>}</section>
<section><div class="hsec__head"><h2 class="section__title">What's wrong with my car?</h2></div>
{syms.length ? <ul class="links">{syms.map(i => <li><a href={issueUrl(i)}>{i.title}</a></li>)}</ul> : <p class="ks__src">Symptom pages appear once their sources are checked.</p>}</section></div>
 : <section class="hsec"><div class="hsec__head"><h2 class="section__title">Check a trouble code</h2></div><form class="code-form" data-code><label class="field"><span>OBD-II code</span><input class="mono" name="q" placeholder="P0455"></label><button class="btn btn--primary btn--lg" style="height:auto">Check code</button></form>
{codes.length > 0 && <ul class="links">{codes.map(i => <li><a href={issueUrl(i)}>{i.code} code</a></li>)}</ul>}</section>}
<div class="hsec"><Feedback path="/" /></div>
</div>
</Base>
