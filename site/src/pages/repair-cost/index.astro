const BLS = 'https://www.bls.gov/oes/current/oes493023.htm';
// Frontmatter is plain TS (no JSX) — build the marked cost spans as HTML strings.
const cost = (v: string) => `<span class="cost" data-src="${BLS}">${v}</span>`;
const wageRows: [string, string, string | null][] = [
  ['10th percentile', '$16.66', '$34,660'],
  ['25th percentile', '$18.70', '$38,900'],
  ['Median', '$24.34', '$50,620'],
  ['Mean', '$27.13', '$56,420'],
  ['75th percentile', '$33.86', '$70,430'],
  ['90th percentile', '$39.32', null],
];
const codes = liveIssues.filter(i => i.type === 'code');
const title = 'Estimating What a Car Repair Will Cost | CarSpecFix';
const description = 'How to estimate what a car repair will cost: the four numbers behind a repair bill, which ones you can verify yourself, and what technicians are paid (BLS).';
const jsonld = [{ '@type': 'Article', headline: 'How to estimate what a car repair will cost', datePublished: '2026-10-20', dateModified: '2026-10-20', author: { '@type': 'Person', name: AUTHOR.name, url: `${SITE}/authors/${AUTHOR.slug}/` }, mainEntityOfPage: SITE + '/repair-cost/' }];
