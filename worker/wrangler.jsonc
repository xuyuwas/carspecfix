{
  // carspecfix feedback relay — declarative source of truth for the bindings.
  // Deploy with: npx wrangler deploy   (from this directory)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carspecfix-feedback",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "account_id": "927de7e28ba2276f10fc911ef280515f",
  "send_email": [
    {
      "name": "EMAIL",
      // Two allowed recipients, both free on any plan:
      //   hello@carspecfix.com  — the address the site publishes. Email Routing
      //                           forwards it to the verified destination below.
      //   xuyu8813@gmail.com    — verified destination; the worker falls back to it
      //                           if a send to hello@ is ever refused, so a form
      //                           submission is never dropped.
      "allowed_destination_addresses": [
        "hello@carspecfix.com",
        "xuyu8813@gmail.com"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "carspecfix.com/api/*",
      "zone_name": "carspecfix.com"
    }
  ]
}
